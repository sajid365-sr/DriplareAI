# =============================================================================
# DRIPLARE AI — Environment Variable Template
# =============================================================================
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# This file is committed and must NEVER contain real secrets — placeholders only.
# `.env` itself is git-ignored (see .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Canonical public URL. Used to build absolute links (invoice pay pages, emails,
# Instagram OAuth redirect). `APP_URL` and `NEXT_PUBLIC_SITE_URL` are legacy
# fallbacks read by lib/services/mail.ts and lib/services/usage-alerts.ts.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_VERSION="0.1.0"

# -----------------------------------------------------------------------------
# Auth — Clerk
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
CLERK_WEBHOOK_SECRET="whsec_xxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/onboarding"

# -----------------------------------------------------------------------------
# Database — Neon Postgres (pgvector)
# -----------------------------------------------------------------------------
# The app connects through a Prisma driver adapter (lib/core/db.ts); the Prisma
# CLI reads DATABASE_URL too (prisma.config.ts).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Direct (non-pooled) connection. `prisma db push` / migrations should use this
# when the pooled endpoint rejects DDL.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# -----------------------------------------------------------------------------
# AI — OpenRouter
# -----------------------------------------------------------------------------
# Single account-wide key. NOTE: OpenRouter rate limits are per ACCOUNT, not per
# key, so rotating keys does not raise the ceiling.
OPENROUTER_API_KEY="sk-or-v1-xxx"

# -----------------------------------------------------------------------------
# n8n — workflow automation
# -----------------------------------------------------------------------------
# ⚠️  PATH MATTERS. Use the production path "/webhook/<name>", never
#    "/webhook-test/<name>".
#
#    "/webhook-test/" only accepts a SINGLE request while "Listen for test event"
#    is active in the n8n editor. In production nothing is listening, so the
#    channel fails silently — Meta gets a 200 from our webhook, n8n never runs,
#    and customers get no reply. `instrumentation.ts` logs an error at boot if it
#    detects a test path in production.
#
#    "/webhook/" is the real path and requires the workflow to be **Active**.
#
# Local development may legitimately use "/webhook-test/" (while the n8n editor
# is listening); production must not.
N8N_HOST="https://your-n8n-host.example.com"
N8N_WEBHOOK_URL="https://your-n8n-host.example.com/webhook/driplare-facebook"
N8N_WHATSAPP_WEBHOOK_URL="https://your-n8n-host.example.com/webhook/driplare-whatsapp"
N8N_INSTAGRAM_WEBHOOK_URL="https://your-n8n-host.example.com/webhook/driplare-instagram"
N8N_INGEST_WEBHOOK_URL="https://your-n8n-host.example.com/webhook/driplare-ingest"
N8N_WEB_WEBHOOK_URL="https://your-n8n-host.example.com/webhook/driplare-web-playground"
# Hosted Firecrawl key for Workspace website discovery and asynchronous page scraping.
FIRECRAWL_API_KEY="fc-xxx"
# Shared secret for n8n → Next.js server-to-server calls (e.g. the session upsert
# route), which bypass Clerk.
N8N_CALLBACK_SECRET="generate-a-long-random-string"

# -----------------------------------------------------------------------------
# Meta — Facebook / Instagram / WhatsApp
# -----------------------------------------------------------------------------
# The Meta app secret signs Meta webhooks (X-Hub-Signature-256) and is used by
# Facebook Login integrations. Instagram Login defaults to these app credentials.
#
# ⚠️  If WhatsApp lives under a DIFFERENT Meta app than Messenger/Instagram, its
#    webhook is signed with a different secret — verification will fail closed
#    (401) and the channel goes dark. Confirm before deploying.
META_APP_SECRET=""
FACEBOOK_APP_SECRET="xxx"
NEXT_PUBLIC_FACEBOOK_APP_ID="xxx"
NEXT_PUBLIC_META_APP_ID="xxx"

# Facebook Login for Business configurations are created once in the Driplare
# Meta App Dashboard. Configure User access tokens and these permissions:
# Facebook: pages_show_list, pages_messaging, pages_manage_metadata,
# pages_read_engagement. Instagram: instagram_basic, instagram_manage_messages,
# pages_show_list, pages_manage_metadata, pages_read_engagement.
# These IDs belong to Driplare's app; merchants never supply them.
NEXT_PUBLIC_FACEBOOK_LOGIN_FOR_BUSINESS_CONFIG_ID="xxx"
NEXT_PUBLIC_INSTAGRAM_LOGIN_FOR_BUSINESS_CONFIG_ID="xxx"

# Optional Instagram Login credential overrides for standalone Professional
# (Business/Creator) accounts that are not linked to a Facebook Page. By default
# the app uses the Driplare Meta App ID/Secret above; merchants never supply these.
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""

# Webhook verification tokens (the `hub.verify_token` echo during subscription).
META_WEBHOOK_VERIFY_TOKEN="xxx"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="xxx"
INSTAGRAM_WEBHOOK_VERIFY_TOKEN="xxx"

# Graph API versions — bump deliberately, not by default.
META_GRAPH_VERSION="v21.0"
WHATSAPP_GRAPH_VERSION="v21.0"
INSTAGRAM_GRAPH_VERSION="v21.0"

# Instagram Login API version and OAuth redirect for standalone Professional
# accounts. The redirect URI must match the Driplare Meta App settings exactly.
INSTAGRAM_LOGIN_GRAPH_VERSION="v27.0"
INSTAGRAM_LOGIN_REDIRECT_URI="http://localhost:3000/api/integrations/instagram/oauth/callback"
# Facebook Login for Business embedded-signup configuration id.
NEXT_PUBLIC_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID="xxx"

# -----------------------------------------------------------------------------
# Payments
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
UDDOKTAPAY_HOSTED_URL="https://sandbox.uddoktapay.com/api/checkout-v2"
UDDOKTAPAY_API_BASE="https://sandbox.uddoktapay.com/api"
UDDOKTAPAY_API_KEY="xxx"

# -----------------------------------------------------------------------------
# Email — Resend
# -----------------------------------------------------------------------------
RESEND_API_KEY="re_xxx"
ADMIN_CONTACT_EMAIL="admin@example.com"

# -----------------------------------------------------------------------------
# Media — Cloudinary
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="xxx"
CLOUDINARY_API_KEY="xxx"
CLOUDINARY_API_SECRET="xxx"

# -----------------------------------------------------------------------------
# Internal secrets
# -----------------------------------------------------------------------------
# Guards the scheduled/billing endpoints that run without a user session.
CRON_SECRET="generate-a-long-random-string"
AUTOMATION_INTERNAL_SECRET="generate-a-long-random-string"

# -----------------------------------------------------------------------------
# Credential encryption at rest
# -----------------------------------------------------------------------------
# AES-256-GCM key for the third-party credentials stored in
# `Integration.config` (Facebook page tokens, WhatsApp Cloud API tokens,
# Instagram long-lived tokens). Without it, connecting a channel fails.
#
# Generate one (32 random bytes, base64 — do NOT reuse any other secret):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# ⚠️  Changing this key makes every already-encrypted token unreadable. If it is
#     ever rotated, the stored values must be re-encrypted in the same release.
# ⚠️  n8n decrypts these tokens itself before using them (it reads them straight
#     from Postgres, not through this app), so the SAME key must also be present
#     in the n8n environment. See docs/integration-token-encryption.md.
#
# `instrumentation.ts` logs the key's 8-character fingerprint at boot in
# production — compare it with n8n's to confirm both sides hold the same key.
INTEGRATION_ENCRYPTION_KEY="base64-encoded-32-byte-key"
