# =============================================================================
# Driplare — cron runner configuration
# =============================================================================
# Install to /etc/driplare/cron.env with permissions 600:
#
#   sudo install -d -m 750 /etc/driplare
#   sudo install -m 600 scripts/cron/cron.env.example /etc/driplare/cron.env
#   sudo -e /etc/driplare/cron.env        # then fill in the real values
#
# This file is intentionally separate from the application's `.env`. Cron needs
# exactly two values, so keeping them in their own file means a leak of it does
# not hand over the database URL, the Clerk keys, or the OpenRouter key.
#
# It must NEVER be committed. `scripts/cron/cron.env` is git-ignored — keep the
# real file out of the repository.
# =============================================================================

# Where the application answers. Trailing slash is fine (it gets stripped).
#   - app on this same VPS:        http://127.0.0.1:3000
#   - app behind Coolify/nginx:    https://your-domain.example
#   - app still on Vercel:         https://your-vercel-domain.example
BASE_URL="https://your-domain.example"

# Must be byte-for-byte identical to the application's CRON_SECRET, otherwise
# every job fails with 401. Generate one with:
#   openssl rand -hex 32
CRON_SECRET="change-me-generate-with-openssl-rand-hex-32"

# ── Optional tuning (defaults shown; uncomment to override) ───────────────────
#CRON_TIMEOUT=120       # seconds per HTTP attempt
#CRON_RETRIES=2         # total attempts per job
#CRON_RETRY_DELAY=15    # seconds between attempts
