{
  "manifest_version": 3,
  "name": "Driplare AI - Meta Business Suite Copilot",
  "version": "1.0.0",
  "description": "Control Driplare AI directly inside Meta Business Suite: Pause/Resume AI, Assign Agents, and Generate Instant Replies.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://business.facebook.com/*",
    "https://*.driplare.com/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://business.facebook.com/*"
      ],
      "js": ["content.js"],
      "css": ["sidebar.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Driplare AI Settings"
  }
}

