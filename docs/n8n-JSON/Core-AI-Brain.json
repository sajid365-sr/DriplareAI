    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT content\nFROM \"Chunk\"\nWHERE embedding IS NOT NULL\n  AND (\n    \"chatbotId\" = '{{ $('When Called by Platform').item.json.chatbotId }}'\n    OR metadata->>'chatbotId' = '{{ $('When Called by Platform').item.json.chatbotId }}'\n  )\nORDER BY embedding <=> '[{{ $json.embedding.values.join(',') }}]'::vector\nLIMIT 5;",
        "options": {}
      },
      "id": "core-rag",
      "name": "RAG Search",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
