    {
      "parameters": {
        "jsCode": "const source = $('Generate IDs').item.json;\nconst items = $input.all();\nconst isTabular = ['xlsx', 'xls', 'csv'].includes(String(source.fileExtension || '').toLowerCase());\nconst cellText = (value) => {\n  if (value === null || value === undefined) return '';\n  if (typeof value === 'string') return value.replace(/\\u0000/g, '').trim();\n  if (typeof value === 'object') return JSON.stringify(value);\n  return String(value);\n};\nlet texts = [];\n\nif (typeof source.extractedText === 'string' && source.extractedText.trim()) {\n  texts.push(source.extractedText.trim());\n} else if (isTabular) {\n  const rows = items.map((item) => {\n    let row = item.json;\n    if (row && typeof row === 'object' && !Array.isArray(row)) {\n      if (row.row && typeof row.row === 'object' && !Array.isArray(row.row)) row = row.row;\n      else if (row.data && typeof row.data === 'object' && !Array.isArray(row.data)) row = row.data;\n    }\n    return row;\n  }).filter((row) => row && typeof row === 'object' && !Array.isArray(row));\n  const columns = [...new Set(rows.flatMap((row) => Object.keys(row).filter((key) => !['sheetName', '__sheetName'].includes(key))))];\n  if (columns.length) {\n    const workbookLabel = String(source.name || 'Spreadsheet').replace(/\\u0000/g, '');\n    texts.push('Workbook: ' + workbookLabel);\n    texts.push('Each row below is a complete record. Field labels are repeated so retrieval keeps every value connected to its column.');\n    rows.forEach((row, index) => {\n      const sheet = row.sheetName || row.__sheetName;\n      const fields = columns.map((column) => column + ': ' + cellText(row[column]));\n      texts.push('Row ' + (index + 1) + (sheet ? ' (Sheet: ' + cellText(sheet) + ')' : '') + ' | ' + fields.join(' | '));\n    });\n  } else {\n    texts.push(...items.map((item) => JSON.stringify(item.json)));\n  }\n} else {\n  for (const item of items) {\n    const json = item.json;\n    if (json.text) texts.push(json.text);\n    else if (json.data) {\n      if (Array.isArray(json.data)) texts.push(json.data.map((page) => page.markdown || page.content || '').join('\\n\\n'));\n      else texts.push(json.data.markdown || json.data.content || '');\n    } else if (json.content) texts.push(json.content);\n    else texts.push(JSON.stringify(json));\n  }\n}\n\nconst fullText = texts.join('\\n\\n').replace(/\\u0000/g, '').trim();\nif (!fullText) throw new Error('No readable text or table rows were found in this file.');\nconst cleanName = String(source.name || '').replace(/\\u0000/g, '');\nreturn [{ json: {\n  fullText,\n  charCount: fullText.length,\n  sourceId: source.sourceId,\n  chatbotId: source.chatbotId,\n  workspaceId: source.workspaceId,\n  isGlobal: source.isGlobal,\n  type: source.type,\n  name: cleanName\n} }];"
      },
