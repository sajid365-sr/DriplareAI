{
  "name": "Source-File-Upload",
  "description": "Processes spreadsheets as labeled row records, uses Gemini OCR for scanned PDFs when text extraction is insufficient, and handles legacy single-URL website requests.",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst binary = $input.first().binary;\nconst id = body.sourceId || ('src_' + Math.random().toString(36).substr(2, 9) + Date.now().toString(36));\n\n// Binary থেকে file extension বের করা (Switch node এ সহজে ম্যাচ করার জন্য)\nlet fileExtension = '';\nif (binary && binary.file) {\n  fileExtension = (binary.file.fileExtension || '').toLowerCase();\n  if (!fileExtension && binary.file.fileName) {\n    const parts = binary.file.fileName.split('.');\n    fileExtension = parts.length > 1 ? parts[parts.length - 1].toLowerCase() : '';\n  }\n}\n\nreturn [{\n  json: {\n    sourceId: id,\n    chatbotId: body.chatbotId || null,\n    workspaceId: body.workspaceId || null,\n    isGlobal: body.isGlobal === true || body.isGlobal === 'true',\n    userId: body.userId,\n    type: body.type,\n    name: body.name || 'Untitled Source',\n    url: body.url,\n    fileExtension: fileExtension,\n    extractedText: typeof body.extractedText === 'string' ? body.extractedText : ''\n  },\n  binary: binary\n}];"
      },
      "id": "34c7e244-7900-4310-859d-63f482a21444",
      "name": "Generate IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -816,
        1216
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH removed_chunks AS (\n  DELETE FROM \"chatbot\".\"Chunk\"\n  WHERE \"sourceId\" = '{{ $json.sourceId }}'\n     OR metadata->>'sourceId' = '{{ $json.sourceId }}'\n)\nINSERT INTO \"chatbot\".\"Source\" (\"id\", \"sourceId\", \"chatbotId\", \"workspaceId\", \"isGlobal\", \"type\", \"name\", \"content\", \"charCount\", \"ingestionStatus\", \"createdAt\")\nVALUES (\n  '{{ $json.sourceId }}',\n  '{{ $json.sourceId }}',\n  NULLIF('{{ $json.chatbotId || \"\" }}', ''),\n  NULLIF('{{ $json.workspaceId || \"\" }}', ''),\n  {{ $json.isGlobal ? 'true' : 'false' }},\n  '{{ $json.type }}',\n  '{{ $json.name.replace(/'/g, \"''\") }}',\n  '{{ $json.fullText.replace(/'/g, \"''\") }}',\n  {{ $json.charCount }},\n  'processing',\n  NOW()\n)\nON CONFLICT (\"sourceId\") DO UPDATE SET\n  \"chatbotId\" = EXCLUDED.\"chatbotId\",\n  \"workspaceId\" = EXCLUDED.\"workspaceId\",\n  \"isGlobal\" = EXCLUDED.\"isGlobal\",\n  \"type\" = EXCLUDED.\"type\",\n  \"name\" = EXCLUDED.\"name\",\n  \"content\" = EXCLUDED.\"content\",\n  \"charCount\" = EXCLUDED.\"charCount\",\n  \"ingestionStatus\" = 'processing';",
        "options": {}
      },
      "id": "aecf58f4-fa99-48e1-87c8-19b455ba4221",
      "name": "Insert into Source",
