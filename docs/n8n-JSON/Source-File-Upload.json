      "parameters": {
        "jsCode": "// Normalize Text1 নোড থেকে ডাটা নেওয়া হচ্ছে\nconst item = $('Normalize Text1').item.json; \n\n// LangChain documentDefaultDataLoader সবসময় 'pageContent' field খোঁজে\n// তাই fullText কে pageContent নামে পাস করতে হবে, না হলে embedding empty হয়\nreturn [{\n    json: {\n        pageContent: item.fullText,\n        sourceId: item.sourceId,\n        chatbotId: item.chatbotId,\n        workspaceId: item.workspaceId\n    }\n}];\n"
      },
