{
  "name": "Facebook-Integration",
  "nodes": [
    {
      "parameters": {
        "content": "## Facebook Integration (lightweight handler)\nVerifies Meta webhook, resolves `pageId → chatbotId`, calls **Core AI Brain**, then sends the reply.\n\n### Setup\n1. Open **Execute Core AI Brain** and select the imported *Core-AI-Brain* workflow.\n2. Meta webhook Verify Token: `driplare_n8n_facebook_secret_2026`.\n3. Subscribe the Page to `messages`, `messaging_postbacks`, `feed`.\n4. Integration.config must hold `pageId` + `pageAccessToken`.",
        "height": 280,
        "width": 440
      },
      "id": "fb-note",
      "name": "Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -1360,
        -60
      ]
    },
    {
      "parameters": {
        "multipleMethods": true,
        "path": "driplare-facebook",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "fb-webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -1360,
        460
      ],
      "webhookId": "driplare-facebook"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "v-mode",
              "leftValue": "={{ $json.query['hub.mode'] }}",
              "rightValue": "subscribe",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "v-token",
              "leftValue": "={{ $json.query['hub.verify_token'] }}",
              "rightValue": "driplare_n8n_facebook_secret_2026",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "fb-verify",
      "name": "If Webhook Verify",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -1140,
        320
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.query['hub.challenge'] }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "fb-challenge",
      "name": "Return hub.challenge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        -920,
        320
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "EVENT_RECEIVED",
        "options": {
          "responseCode": 200
        }
      },
      "id": "fb-ack",
      "name": "Respond 200 to Meta",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        -1140,
        600
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst entry = body && body.entry && body.entry[0];\nif (!entry) return [];\nconst pageId = entry.id;\nconst messaging = entry.messaging && entry.messaging[0];\nconst change = entry.changes && entry.changes[0];\n\n// ── Messenger direct message ──\nif (messaging) {\n  const msg = messaging.message || {};\n  if (msg.is_echo) return [];\n  const senderId = messaging.sender && messaging.sender.id;\n  if (!senderId) return [];\n  let userMessage = msg.text || '';\n  let mediaType = 'text';\n  let mediaUrl = '';\n  const att = msg.attachments && msg.attachments[0];\n  if (att && att.type === 'image') { mediaType = 'image'; mediaUrl = (att.payload && att.payload.url) || ''; }\n  else if (att && att.type === 'audio') { mediaType = 'audio'; mediaUrl = (att.payload && att.payload.url) || ''; }\n  if (!userMessage && mediaType === 'text') return [];\n  return [{ json: { pageId, senderId, isComment: false, commentId: '', sessionId: 'fb_' + senderId, userMessage, mediaType, mediaUrl } }];\n}\n\n// ── Page feed comment ──\nif (change && change.field === 'feed' && change.value && change.value.item === 'comment' && change.value.verb === 'add') {\n  const v = change.value;\n  const fromId = (v.from && v.from.id) || '';\n  if (!fromId || fromId === pageId) return [];\n  if (!v.message) return [];\n  return [{ json: { pageId, senderId: fromId, isComment: true, commentId: v.comment_id || '', sessionId: 'fbc_' + (v.comment_id || fromId), userMessage: v.message, mediaType: 'text', mediaUrl: '' } }];\n}\n\nreturn [];"
      },
      "id": "fb-normalize",
      "name": "Normalize FB Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1060,
        600
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  c.\"chatbotId\",\n  i.\"connected\",\n  i.\"status\",\n  i.config->>'pageId' AS \"pageId\",\n  i.config->>'pageAccessToken' AS \"pageAccessToken\"\nFROM \"Integration\" i\nJOIN \"Chatbot\" c ON i.\"chatbotId\" = c.\"chatbotId\"\nWHERE i.platform = 'facebook'\n  AND i.\"connected\" = true\n  AND i.config->>'pageId' = '{{ $('Normalize FB Payload').item.json.pageId }}'\nLIMIT 1;",
        "options": {}
      },
