        "options": {
          "responseCode": 200
        }
      },
      "id": "wa-challenge",
      "name": "Return hub.challenge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        -920,
        320
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "EVENT_RECEIVED",
        "options": {
          "responseCode": 200
        }
      },
      "id": "wa-ack",
      "name": "Respond 200 to Meta",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        -1140,
        600
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst entry = body && body.entry && body.entry[0];\nconst change = entry && entry.changes && entry.changes[0];\nconst value = change && change.value;\nif (!value) return [];\nconst msg = value.messages && value.messages[0];\nif (!msg) return []; // delivery/read status callbacks — ignore\nconst phoneNumberId = value.metadata && value.metadata.phone_number_id;\nconst from = msg.from;\nif (!from || !phoneNumberId) return [];\nconst profileName = (value.contacts && value.contacts[0] && value.contacts[0].profile && value.contacts[0].profile.name) || '';\n\nlet userMessage = '';\n// NOTE: WhatsApp inbound media arrives as an ID that needs a token-authenticated\n// GET /{mediaId} + download. The generic Core Brain download is unauthenticated,\n// so media is handled as a graceful text fallback here (see Setup Notes).\nlet mediaType = 'text';\nlet mediaUrl = '';\nif (msg.type === 'text') {\n  userMessage = (msg.text && msg.text.body) || '';\n} else if (msg.type === 'image') {\n  const caption = (msg.image && msg.image.caption) || '';\n  userMessage = (caption ? caption + ' ' : '') + '[Customer sent an image on WhatsApp. Politely ask them to describe it or send details as text.]';\n} else if (msg.type === 'audio' || msg.type === 'voice') {\n  userMessage = '[Customer sent a voice message on WhatsApp. Politely ask them to type their question.]';\n} else if (msg.type === 'button' || msg.type === 'interactive') {\n  userMessage = (msg.button && msg.button.text) || (msg.interactive && msg.interactive.button_reply && msg.interactive.button_reply.title) || (msg.interactive && msg.interactive.list_reply && msg.interactive.list_reply.title) || '';\n} else {\n  userMessage = '[Customer sent an unsupported message type. Ask them to send text.]';\n}\nif (!userMessage) return [];\nreturn [{ json: { phoneNumberId, from, sessionId: 'wa_' + from, userMessage, mediaType, mediaUrl, profileName } }];"
      },
      "id": "wa-normalize",
      "name": "Normalize WhatsApp Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1060,
        600
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  c.\"chatbotId\",\n  i.\"connected\",\n  i.\"status\",\n  i.config->>'phoneNumberId' AS \"phoneNumberId\",\n  i.config->>'accessToken' AS \"accessToken\",\n  i.config->>'wabaId' AS \"wabaId\"\nFROM \"Integration\" i\nJOIN \"Chatbot\" c ON i.\"chatbotId\" = c.\"chatbotId\"\nWHERE i.platform = 'whatsapp'\n  AND i.\"connected\" = true\n  AND i.config->>'phoneNumberId' = '{{ $('Normalize WhatsApp Payload').item.json.phoneNumberId }}'\nLIMIT 1;",
        "options": {}
      },
      "id": "wa-fetch",
      "name": "Fetch Integration",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        -840,
        600
      ],
      "credentials": {
        "postgres": {
          "id": "3Aiu7UNMUMPB6aNu",
          "name": "Postgres account"
