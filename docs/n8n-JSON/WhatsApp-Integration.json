              }
            },
            {
              "id": "v-token",
              "leftValue": "={{ $json.query['hub.verify_token'] }}",
              "rightValue": "driplare_n8n_whatsapp_secret_2026",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "wa-verify",
      "name": "If Webhook Verify",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -1140,
        320
      ]
    },
    {
      "parameters": {
