        "jsonBody": "={ \"recipient\": { \"id\": {{ JSON.stringify($('Normalize Instagram Payload').item.json.senderId) }} }, \"message\": { \"attachment\": { \"type\": \"image\", \"payload\": { \"url\": {{ JSON.stringify($json.galleryImages) }} } } } }",
        "options": {}
      },
