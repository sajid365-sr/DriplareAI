{
  "name": "Instagram-Integration",
  "nodes": [
    {
      "parameters": {
        "content": "## Instagram Integration (lightweight handler)\nVerifies Meta webhook, resolves `instagramAccountId → chatbotId`, calls **Core AI Brain**, sends via IG Graph API.\n\n### Setup\n1. Open **Execute Core AI Brain** and select the imported *Core-AI-Brain* workflow.\n2. Verify Token: `driplare_n8n_instagram_secret_2026`.\n3. Integration.config holds `instagramAccountId`, `connectionSource`, and either\n   `instagramAccessToken` (instagram_login) or `pageId` + `pageAccessToken` (facebook_login).",
        "height": 320,
        "width": 460
      },
      "id": "ig-note",
      "name": "Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -1360,
        -80
      ]
    },
    {
      "parameters": {
        "multipleMethods": true,
        "path": "driplare-instagram",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "ig-webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -1360,
        460
      ],
      "webhookId": "driplare-instagram"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "v-mode",
              "leftValue": "={{ $json.query['hub.mode'] }}",
              "rightValue": "subscribe",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "v-token",
              "leftValue": "={{ $json.query['hub.verify_token'] }}",
              "rightValue": "driplare_n8n_instagram_secret_2026",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "ig-verify",
      "name": "If Webhook Verify",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -1140,
        320
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.query['hub.challenge'] }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "ig-challenge",
      "name": "Return hub.challenge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        -920,
        320
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "EVENT_RECEIVED",
        "options": {
          "responseCode": 200
        }
      },
      "id": "ig-ack",
      "name": "Respond 200 to Meta",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        -1140,
        600
      ]
    },
    {
      "parameters": {
        "jsCode": "const meta = $json.body || $json;\nconst entry = meta && meta.entry && meta.entry[0];\nif (!entry) return [];\nconst messaging = entry.messaging && entry.messaging[0];\nconst changeValue = entry.changes && entry.changes[0] && entry.changes[0].value;\n\nconst instagramAccountId = entry.id || (messaging && messaging.recipient && messaging.recipient.id) || (changeValue && changeValue.recipient && changeValue.recipient.id);\nconst senderId = (messaging && messaging.sender && messaging.sender.id) || (changeValue && changeValue.sender && changeValue.sender.id) || (changeValue && changeValue.from && changeValue.from.id);\n\nconst msg = (messaging && messaging.message) || {};\nlet userMessage = msg.text || (changeValue && changeValue.message && changeValue.message.text) || (changeValue && changeValue.text) || '';\nlet mediaType = 'text';\nlet mediaUrl = '';\nconst att = msg.attachments && msg.attachments[0];\nif (att && att.type === 'image') { mediaType = 'image'; mediaUrl = (att.payload && att.payload.url) || ''; }\nelse if (att && att.type === 'audio') { mediaType = 'audio'; mediaUrl = (att.payload && att.payload.url) || ''; }\n\nconst isEcho = Boolean(msg.is_echo || (changeValue && changeValue.message && changeValue.message.is_echo));\nconst isDeleted = Boolean(msg.is_deleted);\nif (!instagramAccountId || !senderId || isEcho || isDeleted) return [];\nif (!userMessage && mediaType === 'text') return [];\nreturn [{ json: { instagramAccountId, senderId, sessionId: 'ig_' + senderId, userMessage, mediaType, mediaUrl } }];"
      },
      "id": "ig-normalize",
      "name": "Normalize Instagram Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1060,
        600
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  c.\"chatbotId\",\n  i.\"connected\",\n  i.\"status\",\n  i.config->>'connectionSource' AS \"connectionSource\",\n  i.config->>'pageId' AS \"pageId\",\n  i.config->>'pageAccessToken' AS \"pageAccessToken\",\n  i.config->>'instagramAccessToken' AS \"instagramAccessToken\",\n  i.config->>'instagramAccountId' AS \"instagramAccountId\"\nFROM \"Integration\" i\nJOIN \"Chatbot\" c ON i.\"chatbotId\" = c.\"chatbotId\"\nWHERE i.platform = 'instagram'\n  AND i.\"connected\" = true\n  AND i.config->>'instagramAccountId' = '{{ $('Normalize Instagram Payload').item.json.instagramAccountId }}'\nLIMIT 1;",
        "options": {}
      },
      "id": "ig-fetch",
      "name": "Fetch Integration",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        -840,
        600
      ],
      "credentials": {
        "postgres": {
          "id": "3Aiu7UNMUMPB6aNu",
          "name": "Postgres account"
        }
      }
    },
