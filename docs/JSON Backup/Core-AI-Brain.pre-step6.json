        "jsCode": "const binaryData = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst base64Data = binaryData.toString('base64');\nreturn {\n  json: {\n    ...$input.item.json,\n    imageBase64: base64Data,\n    mimeType: $binary.data.mimeType || 'image/jpeg'\n  }\n};"
