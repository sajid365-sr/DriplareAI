    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Look up LIVE product catalogue info (name, price, stock, colours, sizes, description, images) for this store. ALWAYS call before answering any product question.",
        "operation": "executeQuery",
        "query": "SELECT \"productId\",\"name\",\"description\",\"price\",\"currency\",\"stock\",\"variants\",\"imageUrl\",\"imageUrls\" FROM \"ecommerce\".\"Product\" WHERE \"chatbotId\" = '{{ $('When Called by Platform').item.json.chatbotId }}' AND \"isActive\" = true AND (\"name\" ILIKE '%' || '{{ $fromAI('product_name', 'the product name or keyword the customer asked about', 'string') }}' || '%' OR \"description\" ILIKE '%' || '{{ $fromAI('product_name', 'the product name or keyword the customer asked about', 'string') }}' || '%') LIMIT 10;",
        "options": {}
      },
      "id": "a3128a39-375c-4014-8c6f-5ff2e0a0468b",
      "name": "Product Lookup",
      "type": "n8n-nodes-base.postgresTool",
      "typeVersion": 2.6,
      "position": [
        2880,
        1264
      ],
      "credentials": {
        "postgres": {
          "id": "3Aiu7UNMUMPB6aNu",
