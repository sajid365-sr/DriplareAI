    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Create a confirmed customer order. Call ONLY when items, quantity, customer name, phone and full delivery address are all known and confirmed.",
        "operation": "executeQuery",
        "query": "INSERT INTO \"ecommerce\".\"Order\" (\"id\",\"orderId\",\"chatbotId\",\"sessionId\",\"customerName\",\"customerPhone\",\"deliveryAddress\",\"district\",\"items\",\"totalAmount\",\"paymentMethod\",\"paymentStatus\",\"status\",\"createdAt\",\"updatedAt\") VALUES (gen_random_uuid()::text, 'ORD-' || upper(substring(md5(random()::text) from 1 for 6)), '{{ $('When Called by Platform').item.json.chatbotId }}', '{{ $('When Called by Platform').item.json.sessionId }}', '{{ $fromAI('customer_name', 'customer full name', 'string') }}', '{{ $fromAI('customer_phone', 'customer phone number', 'string') }}', '{{ $fromAI('delivery_address', 'full delivery address', 'string') }}', '{{ $fromAI('district', 'district or city, empty string if unknown', 'string') }}', '{{ $fromAI('items_json', 'a JSON array string of ordered items, each an object with name, qty and price', 'string') }}'::jsonb, {{ $fromAI('total_amount', 'the total order amount as a number', 'number') }}, 'COD', 'pending', 'Processing', NOW(), NOW()) RETURNING \"orderId\";",
        "options": {}
      },
      "id": "f58bc881-f4f2-4b16-88d5-67033c11304f",
      "name": "Create Order",
      "type": "n8n-nodes-base.postgresTool",
      "typeVersion": 2.6,
      "position": [
        3040,
        1264
      ],
      "credentials": {
        "postgres": {
          "id": "3Aiu7UNMUMPB6aNu",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rawOutput = $('AI Agent').item.json || {};\n\nconst raw = String(rawOutput.output || rawOutput.replyText || rawOutput.text || '');\nconst imgs = [];\nconst re = /\\[IMG\\]\\s*(\\S+)/g;\nlet m;\nwhile ((m = re.exec(raw)) !== null) imgs.push(m[1]);\nconst replyText = raw.replace(/\\[IMG\\]\\s*\\S+/g, '').replace(/\\n{3,}/g, '\\n\\n').trim();\n\nconst model = $('Fetch Bot Config').item.json.model || 'unknown';\n\n// Temporary token estimate. Replaced by n8n's own tracing token counts later.\nconst systemPromptStr = String($('Fetch Bot Config').item.json.systemPrompt || '');\nconst knowledgeCtxStr = String($('Build Context').item.json.knowledgeContext || '');\nconst userMsgStr = String($('Merge Media').item.json.resolvedMessage || '');\nconst fullInputStr = systemPromptStr + '\\n' + knowledgeCtxStr + '\\n' + userMsgStr;\n\nconst promptTokens = Math.ceil(fullInputStr.length / 3.8) + 1350;\nconst completionTokens = Math.ceil(raw.length / 3.7);\nconst totalTokens = promptTokens + completionTokens;\nconst costUsd = Number(((promptTokens * 3.0 + completionTokens * 15.0) / 1000000).toFixed(6));\nconst costBdt = Number((costUsd * 120).toFixed(4));\n\nreturn [{\n  json: {\n    replyText: replyText,\n    galleryImages: imgs,\n    promptTokens: promptTokens,\n    completionTokens: completionTokens,\n    totalTokens: totalTokens,\n    costUsd: costUsd,\n    costBdt: costBdt,\n    model: model,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "9d0361b7-78f7-47a7-b7be-35d0cf88c52e",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3440,
        976
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT EXISTS(\n  SELECT 1 FROM \"ecommerce\".\"Order\"\n  WHERE \"chatbotId\" = '{{ $('When Called by Platform').item.json.chatbotId }}'\n    AND \"sessionId\" = '{{ $('When Called by Platform').item.json.sessionId }}'\n    AND \"createdAt\" > NOW() - INTERVAL '2 minutes'\n) AS \"isOrderCreated\";",
        "options": {}
      },
      "id": "957ed5f0-b7a3-4bf5-a04c-4f3c8f5382aa",
