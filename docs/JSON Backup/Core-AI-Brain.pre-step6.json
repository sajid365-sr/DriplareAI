    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT content FROM \"chatbot\".\"Chunk\" WHERE embedding IS NOT NULL AND (\"chatbotId\" = '{{ $('When Called by Platform').item.json.chatbotId }}' OR metadata->>'chatbotId' = '{{ $('When Called by Platform').item.json.chatbotId }}') ORDER BY embedding <=> '[{{ $json.embedding.values.join(',') }}]'::vector LIMIT 5;",
        "options": {}
      },
