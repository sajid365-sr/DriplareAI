// ══════════════════════════════════════════════════════════════════════════════
// Billing Models — Payments, Credits & AI Usage Tracking
// ══════════════════════════════════════════════════════════════════════════════

model PaymentTransaction {
  id            String    @id @default(cuid())
  sessionId     String    @unique
  userId        String
  packageId     String
  amount        Float
  currency      String
  gateway       String
  paymentStatus String    @default("initiated")
  status        String    @default("pending")
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  // ── Invoice ───────────────────────────────────────────────────────────────
  // কী ধরনের payment: plan upgrade, credit top-up, অথবা admin-issued invoice।
  kind          String    @default("plan") // plan | topup | invoice_credits | invoice_plan | manual_invoice
  invoiceNumber String?   @unique          // Human-readable: INV-YYYYMM-XXXXXX

  // ── Grant idempotency ─────────────────────────────────────────────────────
  // Credit/plan কখন applied হয়েছে। এটি ইচ্ছাকৃতভাবে একটি **real column**
  // (metadata JSON নয়), কারণ grant-টি একটি atomic compare-and-set দিয়ে শুরু হয়:
  //   updateMany({ where: { id, grantedAt: null }, data: { grantedAt: now } })
  // JSON field-এ এই guard করা সম্ভব নয়, ফলে gateway একই webhook দুবার পাঠালে
  // credit দুইবার যোগ হয়ে যেত।
  grantedAt     DateTime?
  grantedKind   String?   // grant-এর ধরন (audit): plan | topup | invoice_credits | invoice_plan

  // ── Payment issues (failed / disputed) ────────────────────────────────────
  failureReason String?   // gateway-provided message (e.g. "insufficient funds")
  failureCode   String?   // gateway-provided code for programmatic handling
  duplicateOfId String?   // duplicate হলে original transaction-এর id
  adminNote     String?   // admin-এর free-text note
  resolvedAt    DateTime? // issue-টি কখন নিষ্পত্তি হয়েছে
  resolvedBy    String?   // যে admin নিষ্পত্তি করেছে

  // ── Refunds ───────────────────────────────────────────────────────────────
  // partial refund সমর্থন করার জন্য amount আলাদা রাখা হয়েছে
  refundStatus  String?   // null | requested | approved | rejected | refunded
  refundAmount  Float?
  refundReason  String?
  refundedAt    DateTime?
  refundedBy    String?   // admin userId

  user          User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  refundRequests RefundRequest[]

  @@index([userId, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([kind, createdAt])
  @@schema("billing")
}

// ── Merchant-initiated refund requests ────────────────────────────────────────
// Merchant dashboard থেকে refund চাইলে সেটি এখানে জমা হয় এবং admin
// `/admin/billing`-এর Payment Issues tab থেকে review করে।
model RefundRequest {
  id              String   @id @default(cuid())
  transactionId   String
  userId          String
  reason          String
  amountRequested Float?   // null = full refund
  status          String   @default("pending") // pending | approved | rejected | processed
  adminNote       String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transaction PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([transactionId])
  @@index([userId])
  @@schema("billing")
}

// ── Usage Threshold Alerts ───────────────────────────────────────────────────
// 80% / 100% credit ব্যবহারে merchant-কে পাঠানো alert-এর record।
//
// `@@unique([userId, cycleStart, threshold, channel])` — এটিই idempotency-র
// মূল রক্ষাকবচ। Application logic একই alert দুইবার trigger করলেও দ্বিতীয়টি
// unique constraint-এ আটকে যাবে, তাই merchant একই cycle-এ দুবার email পাবে না।
// `cycleStart` = user-এর `creditsResetDate`, তাই প্রতি billing cycle-এ
// স্বয়ংক্রিয়ভাবে নতুন key তৈরি হয় — আলাদা cleanup লাগে না।
model UsageAlert {
  id         String   @id @default(cuid())
  userId     String
  cycleStart DateTime
  threshold  Int      // 80 | 100
  channel    String   // email | app
  sentAt     DateTime @default(now())
  user       User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, cycleStart, threshold, channel])
  @@index([userId, cycleStart])
  @@schema("billing")
}

// Credit System — প্রতিটি credit deduction এখানে log হয়
model CreditTransaction {
  id           String   @id @default(cuid())
  userId       String
  chatbotId    String?
  action_type  String   // reply_economy, reply_standard, reply_premium, enhance_prompt, file_embedding, image_message, audio_per_minute, test_chat, credit_purchase, admin_topup, admin_deduct, plan_purchase, plan_change_admin
  model_tier   String?  // economy, standard, premium, manual_adjustment
  credits_spent Int
  metadata     Json?    // extra info (model name, session id, admin audit note, etc.)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([chatbotId, createdAt])
  @@index([action_type, createdAt])
  @@schema("billing")
}

model AIUsageLog {
  id               String     @id @default(cuid())
  userId           String
  workspaceId      String?
  chatbotId        String?
  sessionId        String?
  channel          String     @default("web") // facebook, whatsapp, instagram, playground, compare
  // ── Gateway provenance (TASK-10) ──────────────────────────────────────────
  // কোন **কাজের** জন্য কলটি হয়েছিল — chat, embedding, enhance_prompt,
  // translate, compare, text_ingest, product_extract, auto_train।
  //
  // ⚠️ `channel` এর চেয়ে আলাদা প্রশ্নের উত্তর: `channel` বলে গ্রাহক কোথা
  //    থেকে এসেছে (facebook/whatsapp/web), আর `task` বলে মডেলটি দিয়ে কী করা
  //    হচ্ছে। আগে কিছু row-তে task-এর মান `channel`-এ ঢুকেছিল (enhance_prompt,
  //    compare, auto_train), তাই একই কলামে দুই অর্থ ছিল — খরচ বিশ্লেষণে
  //    সেগুলো আলাদা করা যেত না। নতুন কলামে task সবসময় নিজের জায়গায় থাকবে।
  //
  // null = কলটি gateway-র বাইরে থেকে হয়েছে (পুরনো row বা এখনো migrate হয়নি)।
  task             String?
  model            String
  modelId          String     @default("") // Full OpenRouter model ID e.g. "openai/gpt-4o-mini"
  promptTokens     Int        @default(0)
  completionTokens Int        @default(0)
  totalTokens      Int        @default(0)
  // একটি reply-তে কতগুলো LLM call লেগেছে (agent-এর tool loop-এ একাধিক হতে পারে)।
  // খরচ বিশ্লেষণে দরকার — একই reply-তে ৩টি call হলে খরচও তিনগুণ।
  llmCallCount     Int        @default(0)
  costUsd          Float      @default(0) // Calculated actual OpenRouter cost in USD
  costBdt          Float      @default(0) // রেফারেন্সের জন্য জমা রাখা ৳ (লেখার সময়ের রেটে)। রিপোর্ট/UI কখনোই এটি যোগ করে না — `costUsd`-কে বর্তমান রেটে গুণ করা হয়।
  creditsDeducted  Int        @default(0) // Credits charged to the merchant
  isFreeMessage    Boolean    @default(false)

  // ── Cost provenance ───────────────────────────────────────────────────────
  // এই row-এর খরচটা কীভাবে বের হলো। Admin panel এই মান দেখেই "Exact" বনাম
  // "Estimated" ব্যাজ দেখায় — তাই মার্চেন্ট-বিল নিয়ে সিদ্ধান্ত নেওয়ার আগে
  // costSource কী তা দেখা জরুরি।
  //   exact     = n8n execution-এর metadata.tracing থেকে পাওয়া আসল token × লাইভ দাম
  //   estimated = token length থেকে অনুমান করা, তাই দাম আনুমানিক
  //   allocated = দিনের মোট OpenRouter খরচ token-share অনুপাতে workspace-এ ভাগ করা
  costSource       String     @default("estimated")

  // ── Resiliency provenance (TASK-10) ───────────────────────────────────────
  // gateway কলটিতে মোট কত মিলিসেকেন্ড লাগল — retry ও fallback-সহ পুরো সময়।
  // `channel`/`model`-এর পাশে এটি না থাকলে "fallback আসলে কত খরচ করল" প্রশ্নের
  // উত্তর দেওয়া যেত না, আর TASK-11-এর আগে/পরে তুলনাও করা যেত না।
  latencyMs        Int?

  // fallback ঘটলে **প্রথমে যে মডেলটি চেষ্টা করা হয়েছিল** সেটি। null = প্রথম
  // মডেলেই সফল, অর্থাৎ কোনো fallback লাগেনি।
  //
  // ⚠️ `model` কলামে সবসময় **যে মডেলটি সত্যিই উত্তর দিয়েছে** সেটিই থাকে —
  //    এখানে সেটি নয়। এই দুই মান একসাথে রাখলে বোঝা যায় কতগুলো reply নীরবে
  //    সস্তা/অন্য মডেলে গিয়ে পড়ছে, যেটা primary মডেলের সমস্যার একমাত্র সংকেত।
  fallbackFrom     String?

  // n8n execution id — এক message = এক run। দুটি কাজ করে:
  //   ১. Idempotency — একই runId আবার এলে নতুন row নয়, বিদ্যমানটাই update হয়।
  //   ২. Exact reconciler এই runId দিয়ে n8n REST API থেকে আসল token এনে row ঠিক করে।
  runId            String?    @unique
  // Row-টি কখন আসল (exact) token দিয়ে ঠিক করা হয়েছে। null = এখনো estimated।
  reconciledAt     DateTime?

  createdAt        DateTime   @default(now())
  user             User       @relation(fields: [userId], references: [userId], onDelete: Cascade)
  workspace        Workspace? @relation(fields: [workspaceId], references: [workspaceId], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([chatbotId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([channel])
  @@index([costSource, createdAt])
  @@schema("billing")
}
