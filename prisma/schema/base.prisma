// ══════════════════════════════════════════════════════════════════════════════
// Base Configuration — Generator & Datasource
// ══════════════════════════════════════════════════════════════════════════════

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
  schemas    = ["public", "app_auth", "chatbot", "ecommerce", "courier", "billing", "admin"]
}
